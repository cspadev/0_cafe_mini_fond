# Comma-separated origins of the host application (main game) allowed to send INIT to the minigame.
# When empty, any parent window is accepted and READY is posted with target origin "*".
VITE_ALLOWED_PARENT_ORIGINS=https://host.example.com

# Statistics API (server only, never VITE_-prefixed). `vercel env pull .env.local` fills both on a linked project.
# Postgres connection string; Neon via the Vercel Marketplace sets DATABASE_URL.
DATABASE_URL=
# Random string (e.g. `openssl rand -base64 32`) the game tokens are signed with.
SCORE_SECRET=
